<div id="dropdown" class="dropdown_hidden">
  <ul>
    <% if current_user %>
      <li style="padding-bottom:2px;">
        <%= link_to "アカウント情報", users_path, style: 'font-weight:600;' %>
      </li>
      <li>
        <%= link_to "アカウントページ", user_path(current_user) %>
      </li>
      <li>
        <%= link_to "アカウント情報編集", edit_account_users_path %>
      </li>
      <li>
        <%= link_to "プロフィール情報編集", edit_profile_users_path %>
      </li>
      <li>
        <%= link_to "登録した施設", mine_rooms_path %>
      </li>
      <li>
        <%= link_to "宿登録はこちら", new_room_path, style: 'color:#0ea5a4;font-weight:600;' %>
      </li>
      <div class="divider"><div>
      <li>
        <%= button_to "ログアウト", logout_path, method: :delete, data: { confirm: "本当にログアウトしますか？" }, form: { "data-turbo" => "false", style: "display:inline;" }, class: "dropdown-logout-btn" %>

      </li>
    <% else %>
      <li><%= link_to "ログイン", login_users_path, style: 'font-weight:600;' %></li>
      <li><%= link_to "新規登録", new_user_path %></li>
    <% end %>
  </ul>
</div>
