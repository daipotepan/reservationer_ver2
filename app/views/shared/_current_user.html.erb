<div class="user-menu">
  <div class="user-info" id="user_info">
    <% if current_user %>
      <% avatar_src = current_user.icon.presence || "https://rails-02-sample.herokuapp.com/assets/common/default-avatar.png" %>

      <%= tag.img src: avatar_src,
                  alt: "プロフィール画像",
                  id: "icon",
                  class: "icon" %>

      <span class="user-name"><%= current_user.name %> さん</span>

      <div id="dropdown-overlay-root"></div>
      <%= render "shared/dropdown" %>
    <% else %>
      <div class="guest-box">
        <p>ログインしていません</p>
        <div class="auth-links">
          <%= link_to "ログイン", login_users_path, class: "btn btn-login" %>
          <%= link_to "新規登録", new_user_path, class: "btn btn-signup" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
