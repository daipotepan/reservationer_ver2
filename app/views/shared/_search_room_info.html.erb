<div class="search-room-info">
  <%= form_with url: search_room_info_applications_path, scope: :room, local: true do |f| %>
    <table>
      <tr>
        <th><%= f.label :room_info, "探したい部屋の情報" %></th>
        <td><%= f.text_field :room_info %></td>
      </tr>
    </table>

    <div class="search-actions">
      <ul>
        <li><%= f.submit "検索する" %></li>
      </ul>
    </div>
  <% end %>
</div>