<div class="card" style="max-width:480px;margin:32px auto;">
  <h3 class="page-title">施設情報編集</h3>
  <%= render "shared/error", obj: @room %>
  <%= form_with model: @room, url: room_path(@room), method: :patch, multipart: true do |f| %>
    <table class="form-table" style="width:100%;margin-bottom:0;">
      <tr>
        <th><%= f.label :room_img, "施設画像" %></th>
        <td><%= f.file_field :room_img %></td>
      </tr>
      <tr>
        <th><%= f.label :name, "施設名前" %></th>
        <td><%= f.text_field :name, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :introduction, "紹介文" %></th>
        <td><%= f.text_area :introduction, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :payment_amount, "宿泊料金(/日)" %></th>
        <td><%= f.text_field :payment_amount, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :address, "住所" %></th>
        <td><%= f.text_field :address, class: "form-input" %></td>
      </tr>
    </table>
    <div class="form-actions">
      <ul>
        <li><%= f.submit "更新する", class: "btn btn-primary" %></li>
        <li><%= link_to "戻る", mine_rooms_path, class: "btn btn-outline" %></li>
      </ul>
    </div>
  <% end %>
</div>
