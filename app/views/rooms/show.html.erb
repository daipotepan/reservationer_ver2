

<div class="card">
  <h3 class="page-title">施設詳細</h3>

  <table class="form-table">
  <thead>
    <tr>
      <th>施設画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金（/日）</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <% img_src = @room.room_img.to_s.strip.presence || "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png" %>
      <td><%= tag.img src: img_src, alt: @room.name, class: "facility-image" %></td>
      <td><%= @room.name %></td>
      <td class="truncate-intro"><%= @room.introduction %></td>
      <td><%= @room.payment_amount %></td>
    </tr>
  </tbody>
</table>

  <div style="margin-top:12px; display:flex; gap:8px;">
    <%= link_to "前のページに戻る", (request.referer || root_path), class: "btn btn-outline" %>
    <%= link_to "予約する", new_reservation_path(room_id: @room.id), class: "btn btn-primary" %>
  </div>
</div>

