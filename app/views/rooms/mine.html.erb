<%= render "shared/current_user" %>

<div class="card">
  <h3 class="page-title">登録した施設一覧</h3>

  <% if @rooms.present? %>
    <table class="styled-table rooms-table">
      <thead>
        <tr>
          <th>施設画像</th>
          <th>施設名</th>
          <th>紹介文</th>
          <th>宿泊料金</th>
          <th>作成日</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @rooms.each do |room| %>
          <tr>
            <% img_src = room.room_img.to_s.strip.presence || "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png" %>
            <td class="img-cell"><%= tag.img src: img_src, alt: room.name, class: "facility-image" %></td>
            <td><%= room.name %></td>
            <td class="intro"><%= room.introduction %></td>
            <td class="price">¥<%= number_with_delimiter(room.payment_amount) %></td>
            <td><%= room.created_at.to_fs(:datetime_jp) %></td>
            <td class="actions">
              <%= link_to "編集", edit_room_path(room), class: "btn btn-outline" %>
              <%= link_to "削除", room_path(room), data: {turbo_method: :delete, turbo_confirm: "この施設を削除しますか？"}, class: "btn btn-outline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">登録した施設はありません。</p>
  <% end %>
</div>
