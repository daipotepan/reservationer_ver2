<%= render "shared/dropdown" %>

<%= render "shared/current_user" %>


<h3>予約できる施設一覧</h3>


<table>
  <thead>
    <tr>
      <th>施設画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金</th>
      <th>作成日</th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td><img><%= room.room_img %></td>
        <td><%= room.name %></td>
        <td><%= room.introduction %></td>
        <td><%= room.payment_amount %></td>
        <td><%= room.created_at.to_fs(:date_jp) %></td>
        <td>
          <%= link_to "詳細", room %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
