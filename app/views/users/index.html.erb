<%= render "shared/current_user" %>

<h3>ユーザー情報一覧</h3>



<table>
  <thead>
    <tr>
      <th>メールアドレス</th>
      <th>パスワード</th>
    </tr>
  </thead>

  <tbody>
    <% if @user.present? %>
      <tr>
        <td><%= @user.email %></td>
        <td><%= "*" * (@user.password.to_s.length) %></td>
      </tr>
    <% else %>
      <tr>
        <td colspan="2">ログインしていません</td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "宿登録はこちら", new_room_path %></p>