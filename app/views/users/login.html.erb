<div class="card">
  <h3 class="page-title">ログイン</h3>

  <%= form_with url: login_users_path, scope: :user, local: true do |f| %>
    <table class="form-table">
      <tr>
        <th><%= f.label :email, "メールアドレス" %></th>
        <td><%= f.email_field :email, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :password, "パスワード" %></th>
        <td><%= f.password_field :password, class: "form-input" %></td>
      </tr>
    </table>

    <div class="form-actions">
      <ul>
        <li><%= f.submit "ログインする", class: "btn btn-primary" %></li>
        <li><%= link_to "アカウント新規作成", new_user_path, class: "btn btn-outline" %></li>
      </ul>
    </div>
  <% end %>
</div>