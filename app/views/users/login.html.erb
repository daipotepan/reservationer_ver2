<h3>ログイン</h3>

<%= form_with url: login_users_path, scope: :user, local: true do |f| %>
  <table>
    <tr>
      <th><%= f.label :email, "メールアドレス" %></th>
      <td><%= f.email_field :email %></td>
    </tr>
    <tr>
      <th><%= f.label :password, "パスワード" %></th>
      <td><%= f.password_field :password %></td>
    </tr>
  </table>

 
  <div>
    <ul>
      <li><%= f.submit "ログインする" %></li>
      <li><%= link_to "アカウント新規作成", new_users_path %></li>
    </ul>
  </div>
<% end %>