
<%= render "shared/error", obj: @user %>

<div class="card">
  <h3 class="page-title">新規登録</h3>
  <%= form_with model: @user, local: true, html: { multipart: true } do |f| %>
    <table class="form-table">
      <tr>
        <th><%= f.label :icon, "アイコン" %></th>
        <td>
          <label for="icon_input" class="avatar-preview" id="avatar_preview" style="cursor:pointer;">
            <span class="avatar-placeholder">PNG/JPG（クリックして選択）</span>
          </label>
          <%= f.file_field :icon, id: "icon_input", class: "form-input", accept: "image/*", style: "display:none;" %>
        </td>
      </tr>
      <tr>
        <th><%= f.label :name, "名前" %></th>
        <td><%= f.text_field :name, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :email, "メールアドレス" %></th>
        <td><%= f.email_field :email, class: "form-input" %></td>
      </tr>
      <tr>
        <th><%= f.label :password, "パスワード" %></th>
        <td><%= f.password_field :password, class: "form-input", autocomplete: "new-password" %></td>
      </tr>
      <tr>
        <th><%= f.label :password_confirmation, "確認用パスワード" %></th>
        <td><%= f.password_field :password_confirmation, class: "form-input", autocomplete: "new-password" %></td>
      </tr>
    </table>
    <div class="form-actions" style="margin-top:24px;">
      <ul>
        <li><%= f.submit "登録する", class: "btn btn-primary" %></li>
      </ul>
    </div>
  <% end %>
</div>