<%= render "shared/current_user" %>

<%= render "shared/search_address" %>
<%= render "shared/search_room_info" %>

<h3>予約できる施設一覧</h3>



<table class="styled-table">
  <% if @rooms.present? %>
    <thead>
      <tr>
        <th>施設画像</th>
        <th>施設名</th>
        <th>紹介文</th>
        <th>住所</th>
        <th>宿泊料金</th>
      </tr>
    </thead>
    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <% img_src = room.room_img.to_s.strip.presence || "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png" %>
          <td class="img-cell"><%= tag.img src: img_src, alt: room.name, class: "facility-image" %></td>
          <td><%= room.name %></td>
          <td><%= room.introduction %></td>
          <td><%= room.address %></td>
          <td><%= room.payment_amount %></td>
          <td>
            <%= link_to "詳細", room %>
          </td>
          <td>
            <%= link_to "予約する", new_reservation_path(room_id: room.id) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% else %>
    <p>該当する施設は見つかりませんでした。</p>
  <% end %>
</table>
